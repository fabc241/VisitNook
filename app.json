{
  "expo": {
    "name": "Visit Notes",
    "slug": "visit-notes",
    "scheme": "visitnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.visitnotes.app",
      "appleTeamId": "5CYK686SKS",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "@qvac/sdk/expo-plugin",
      "expo-build-properties",
      [
        "expo-audio",
        {
          "microphonePermission": "Visit Notes records your doctor visits so they can be transcribed and summarized on this iPhone. Audio never leaves your device.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Visit Notes adds follow-up appointments your doctor mentioned, only after you confirm each one."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Visit Notes uses Face ID to keep your visit records private."
        }
      ],
      "expo-sharing",
      "expo-asset"
    ]
  }
}
